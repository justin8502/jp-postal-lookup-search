{
  "name": "jp-postal-lookup-search",
  "version": "1.0.1",
  "description": "Japanese postal code and address lookup with partial matching and normalization",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "tsx ./src/tests/lookup-search-test.ts && tsx ./src/tests/models-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "japan",
    "postal-code",
    "address",
    "zipcode",
    "ken-all",
    "japanese-address"
  ],
  "author": "Justin Ang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justin8502/jp-postal-lookup-search"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
